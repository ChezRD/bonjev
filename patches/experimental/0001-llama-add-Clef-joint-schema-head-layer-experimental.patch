@@ -0,0 +1,97 @@
+// Optional Clef joint schema head executed as a ggml layer on top of the
+// backbone's final hidden states. Weights come from a GGUF packed by
+// benchmarks/head_to_gguf.py; the layer's outputs are logits per option.
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+struct llama_head {
+    struct ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    // Reused graph allocator (liveness) so the per-call graph buffer stays
+    // small and is not re-created on the device for every run.
+    ggml_gallocr_t galloc = nullptr;
+    std::map<std::string, struct ggml_tensor *> tensors;
+
+    int hidden_size = 0;
+    int width = 0;
+    int routing_layers = 0;
+    int layers = 0;
+    int n_heads = 0;
+    int feedforward = 0;
+
+    // Precomputed from the trained scalars: exp(clamp(x, max=ln 100)) and sigmoid.
+    float prior_scale = 1.0f;
+    float joint_scale = 1.0f;
+    float gate = 0.0f;
+
+    // Per-request inputs, kept in their own context + backend buffer and used
+    // as leaves of the model graph (like LoRA side weights).
+    struct ggml_context * req_ctx = nullptr;
+    ggml_backend_buffer_t req_buf = nullptr;
+    struct ggml_tensor * t_a_q = nullptr;   // [n_tokens, n_questions]
+    struct ggml_tensor * t_a_o = nullptr;   // [n_tokens, n_options]
+    struct ggml_tensor * t_oq = nullptr;    // [n_questions, n_options]
+    struct ggml_tensor * t_mask = nullptr;  // [n_options, n_questions]
+    struct ggml_tensor * t_lex = nullptr;   // [hidden, n_options]
+    struct ggml_tensor * t_type = nullptr;  // [n_questions]
+    struct ggml_tensor * t_last = nullptr;  // [1]
+    struct ggml_tensor * t_acc = nullptr;   // [hidden, acc_rows] previous chunks
+    int rec_n_questions = 0;
+    int rec_n_options = 0;
+    int rec_n_tokens = 0;
+};
+
+// Per-request geometry of the head layer.
+struct llama_head_record {
+    int n_tokens = 0;
+    int n_questions = 0;
+    int n_options = 0;
+
+    const float * a_q = nullptr;        // [n_tokens, n_questions]  span means for questions
+    const float * a_o = nullptr;        // [n_tokens, n_options]    span means for option contexts
+    const float * oq = nullptr;         // [n_questions, n_options] option -> question one-hot
+    const float * mask = nullptr;       // [n_options, n_questions] softmax mask (0 / -inf)
+    const float * lex = nullptr;        // [n_options, hidden_size] lexical rows per option
+    const int32_t * type_ids = nullptr; // [n_questions] 0=noul 1=choice 2=score
+    int32_t last_token = 0;
+};
+
+// Load the head GGUF into backend tensors. False on failure.
+bool head_layer_load(llama_head & head, const char * path, ggml_backend_t backend);
+
+// Free the loaded weights.
+void head_layer_free(llama_head & head);
+
+// Create the per-request input tensors (spans, lexical rows, mask, ...) and
+// upload them together with the already-decoded hidden states of previous
+// chunks. `backend` is the head's backend.
+bool head_prepare(
+        llama_head & head,
+        ggml_backend_t backend,
+        const llama_head_record & rec,
+        const float * acc_hidden,
+        int acc_rows);
+
+// Build the head stage into an existing model graph context, reading the
+// final-norm hidden states `hidden` ([hidden_size, n_tokens]). Returns the
+// per-option logits tensor.
+struct ggml_tensor * head_build_graph(
+        struct ggml_context * ctx,
+        const llama_head & head,
+        struct ggml_tensor * hidden);
+
+// Run the head layer on `hidden` ([n_tokens, hidden_size] row-major, host) and
+// return one logit per option.
+bool head_layer_forward(
+        const llama_head & head,
+        ggml_backend_t backend,
+        const llama_head_record & rec,
+        const float * hidden,
+        std::vector<float> & logits);
