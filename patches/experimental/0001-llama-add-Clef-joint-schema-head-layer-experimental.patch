+// Clef joint schema head as a ggml layer. See llama-head.h.
+#include "llama-head.h"
+
+#include "ggml-alloc.h"
+#include "gguf.h"
+#include "llama-impl.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+
+static struct ggml_tensor * head_tensor(const llama_head & head, const char * name) {
+    const auto it = head.tensors.find(name);
+    if (it == head.tensors.end()) {
+        fprintf(stderr, "llama_head: missing tensor '%s'\n", name);
+        return nullptr;
+    }
+    return it->second;
+}
+
+static struct ggml_tensor * head_mm(
+        struct ggml_context * ctx,
+        const llama_head & head,
+        const char * name,
+        struct ggml_tensor * x) {
+    struct ggml_tensor * w = head_tensor(head, name);
+    return w ? ggml_mul_mat(ctx, w, x) : nullptr;
+}
+
+static struct ggml_tensor * head_linear(
+        struct ggml_context * ctx,
+        const llama_head & head,
+        const char * name,
+        struct ggml_tensor * x) {
+    struct ggml_tensor * w = head_tensor(head, (std::string(name) + ".weight").c_str());
+    struct ggml_tensor * b = head_tensor(head, (std::string(name) + ".bias").c_str());
+    if (!w || !b) {
+        return nullptr;
+    }
+    return ggml_add(ctx, ggml_mul_mat(ctx, w, x), b);
+}
+
+static struct ggml_tensor * head_layernorm(
+        struct ggml_context * ctx,
+        struct ggml_tensor * x,
+        struct ggml_tensor * w,
+        struct ggml_tensor * b) {
+    return ggml_add(ctx, ggml_mul(ctx, ggml_norm(ctx, x, 1e-5f), w), b);
+}
+
+static struct ggml_tensor * head_normalize(struct ggml_context * ctx, struct ggml_tensor * x) {
+    // F.normalize: x / max(||x||, 1e-12) over the feature axis.
+    struct ggml_tensor * sq = ggml_sum_rows(ctx, ggml_sqr(ctx, x));
+    struct ggml_tensor * norm = ggml_sqrt(ctx, ggml_clamp(ctx, sq, 1e-12f, std::numeric_limits<float>::max()));
+    return ggml_div(ctx, x, norm);
+}
+
+static struct ggml_tensor * head_mha(
+        struct ggml_context * ctx,
+        const llama_head & head,
+        const char * prefix,
+        struct ggml_tensor * q,
+        struct ggml_tensor * k,
+        struct ggml_tensor * v) {
+    const int e = head.width;
+    const int h = head.n_heads;
+    const int d = e / h;
+    const int64_t lq = q->ne[1];
+    const int64_t lk = k->ne[1];
+
+    struct ggml_tensor * in_w = head_tensor(head, (std::string(prefix) + ".in_proj_weight").c_str());
+    struct ggml_tensor * in_b = head_tensor(head, (std::string(prefix) + ".in_proj_bias").c_str());
+    struct ggml_tensor * out_w = head_tensor(head, (std::string(prefix) + ".out_proj.weight").c_str());
+    struct ggml_tensor * out_b = head_tensor(head, (std::string(prefix) + ".out_proj.bias").c_str());
+    if (!in_w || !in_b || !out_w || !out_b) {
+        return nullptr;
+    }
+
+    struct ggml_tensor * wq = ggml_cont(ctx, ggml_view_2d(ctx, in_w, e, e, in_w->nb[1], 0));
+    struct ggml_tensor * wk = ggml_cont(ctx, ggml_view_2d(ctx, in_w, e, e, in_w->nb[1], (size_t) e * in_w->nb[1]));
+    struct ggml_tensor * wv = ggml_cont(ctx, ggml_view_2d(ctx, in_w, e, e, in_w->nb[1], (size_t) 2 * e * in_w->nb[1]));
+    struct ggml_tensor * bq = ggml_view_1d(ctx, in_b, e, 0);
+    struct ggml_tensor * bk = ggml_view_1d(ctx, in_b, e, (size_t) e * in_b->nb[0]);
+    struct ggml_tensor * bv = ggml_view_1d(ctx, in_b, e, (size_t) 2 * e * in_b->nb[0]);
+
+    struct ggml_tensor * qp = ggml_add(ctx, ggml_mul_mat(ctx, wq, q), bq);
+    struct ggml_tensor * kp = ggml_add(ctx, ggml_mul_mat(ctx, wk, k), bk);
+    struct ggml_tensor * vp = ggml_add(ctx, ggml_mul_mat(ctx, wv, v), bv);
+
+    struct ggml_tensor * qh = ggml_reshape_3d(ctx, qp, d, h, lq);
+    struct ggml_tensor * kh = ggml_reshape_3d(ctx, kp, d, h, lk);
+    struct ggml_tensor * vh = ggml_reshape_3d(ctx, vp, d, h, lk);
+
+    struct ggml_tensor * attn = nullptr;
+    for (int i = 0; i < h; ++i) {
+        struct ggml_tensor * q_i = ggml_view_2d(ctx, qh, d, lq, qh->nb[2], (size_t) i * qh->nb[1]);
+        struct ggml_tensor * k_i = ggml_view_2d(ctx, kh, d, lk, kh->nb[2], (size_t) i * kh->nb[1]);
+        struct ggml_tensor * v_i = ggml_view_2d(ctx, vh, d, lk, vh->nb[2], (size_t) i * vh->nb[1]);
+        struct ggml_tensor * scores = ggml_mul_mat(ctx, k_i, q_i);              // [lk, lq]
+        scores = ggml_soft_max(ctx, ggml_scale(ctx, scores, 1.0f / std::sqrt((float) d)));
+        struct ggml_tensor * vt = ggml_cont(ctx, ggml_transpose(ctx, v_i));     // [lk, d]
+        struct ggml_tensor * out_i = ggml_mul_mat(ctx, vt, scores);             // [d, lq]
+        attn = attn ? ggml_concat(ctx, attn, out_i, 0) : out_i;                 // [d*h, lq]
+    }
+    return ggml_add(ctx, ggml_mul_mat(ctx, out_w, attn), out_b);
+}
+
+
+// Exact erf-based GELU (PyTorch nn.GELU) via Abramowitz-Stegun 7.1.26,
+// |error| < 1.5e-7. ggml only ships the tanh approximation.
+static struct ggml_tensor * head_gelu_erf(struct ggml_context * ctx, struct ggml_tensor * x) {
+    const float inv_sqrt2 = 0.7071067811865476f;
+    const float p  = 0.3275911f;
+    const float a1 = 0.254829592f;
+    const float a2 = -0.284496736f;
+    const float a3 = 1.421413741f;
+    const float a4 = -1.453152027f;
+    const float a5 = 1.061405429f;
+
+    struct ggml_tensor * z = ggml_scale(ctx, x, inv_sqrt2);
+    struct ggml_tensor * az = ggml_abs(ctx, z);
+    struct ggml_tensor * ones = ggml_scale_bias(ctx, az, 0.0f, 1.0f);
+    struct ggml_tensor * t = ggml_div(ctx, ones, ggml_add(ctx, ggml_scale(ctx, az, p), ones));
+    struct ggml_tensor * h = ggml_scale_bias(ctx, t, a5, a4);
+    h = ggml_scale_bias(ctx, ggml_mul(ctx, t, h), 1.0f, a3);
+    h = ggml_scale_bias(ctx, ggml_mul(ctx, t, h), 1.0f, a2);
+    h = ggml_scale_bias(ctx, ggml_mul(ctx, t, h), 1.0f, a1);
+    struct ggml_tensor * poly = ggml_mul(ctx, t, h);
+    struct ggml_tensor * e = ggml_exp(ctx, ggml_neg(ctx, ggml_mul(ctx, az, az)));
+    struct ggml_tensor * erf_abs = ggml_scale_bias(ctx, ggml_mul(ctx, poly, e), -1.0f, 1.0f);
+    struct ggml_tensor * erf = ggml_mul(ctx, erf_abs, ggml_sgn(ctx, z));
+    return ggml_mul(ctx, ggml_scale(ctx, x, 0.5f), ggml_scale_bias(ctx, erf, 1.0f, 1.0f));
+}
+
+static struct ggml_tensor * build_head(
+        struct ggml_context * ctx,
+        const llama_head & head,
+        const llama_head_record & rec,
+        struct ggml_tensor * hidden,
+        struct ggml_tensor * a_q,
+        struct ggml_tensor * a_o,
+        struct ggml_tensor * oq,
+        struct ggml_tensor * mask,
+        struct ggml_tensor * lex,
+        struct ggml_tensor * type_ids,
+        struct ggml_tensor * last) {
+    const int e = head.width;
+    const int nq = rec.n_questions;
+    const int no = rec.n_options;
+
+    struct ggml_tensor * hn = head_layernorm(
+            ctx, hidden,
+            head_tensor(head, "hidden_norm.weight"),
+            head_tensor(head, "hidden_norm.bias"));
+    if (!hn) {
+        return nullptr;
+    }
+
+    struct ggml_tensor * memory = head_mm(ctx, head, "memory_projection.weight", hn);          // [e, T]
+    ggml_set_name(memory, "head.memory");
+    struct ggml_tensor * qvec = ggml_mul_mat(ctx, ggml_cont(ctx, ggml_transpose(ctx, hn)), a_q);                                    // [5120, nq]
+    ggml_set_name(qvec, "head.qvec");
+    struct ggml_tensor * glob = ggml_get_rows(ctx, hn, last);                                  // [5120, 1]
+    struct ggml_tensor * ctxo = ggml_mul_mat(ctx, ggml_cont(ctx, ggml_transpose(ctx, hn)), a_o);                                    // [5120, no]
+    ggml_set_name(ctxo, "head.ctxo");
+    struct ggml_tensor * qproj = head_mm(ctx, head, "option_question_projection.weight", qvec); // [e, nq]
+    struct ggml_tensor * qproj_o = ggml_mul_mat(ctx, ggml_cont(ctx, ggml_transpose(ctx, qproj)), oq);                               // [e, no]
+    struct ggml_tensor * oc_proj = head_mm(ctx, head, "option_context_projection.weight", ctxo);
+    struct ggml_tensor * ol_proj = head_mm(ctx, head, "option_lexical_projection.weight", lex);
+    struct ggml_tensor * routed = ggml_add(ctx, ggml_add(ctx, oc_proj, ol_proj), qproj_o);      // [e, no]
+    ggml_set_name(routed, "head.routed0");
+    ggml_set_name(oc_proj, "head.oc_proj");
+    ggml_set_name(ol_proj, "head.ol_proj");
+    ggml_set_name(qproj_o, "head.oq_proj");
+
+    // Evidence routing layers: options attend to the whole state.
+    for (int i = 0; i < head.routing_layers; ++i) {
+        const std::string p = "evidence_layers." + std::to_string(i);
+        struct ggml_tensor * qn = head_layernorm(
+                ctx, routed,
+                head_tensor(head, (p + ".query_norm.weight").c_str()),
+                head_tensor(head, (p + ".query_norm.bias").c_str()));
+        struct ggml_tensor * mn = head_layernorm(
+                ctx, memory,
+                head_tensor(head, (p + ".memory_norm.weight").c_str()),
+                head_tensor(head, (p + ".memory_norm.bias").c_str()));
+        struct ggml_tensor * attn = head_mha(ctx, head, (p + ".attention").c_str(), qn, mn, mn);
+        if (i == 0) {
+            ggml_set_name(qn, "head.ev0_qn");
+            ggml_set_name(mn, "head.ev0_mn");
+            ggml_set_name(attn, "head.ev0_attn");
+        }
+        routed = ggml_add(ctx, routed, attn);
+        struct ggml_tensor * fn = head_layernorm(
+                ctx, routed,
+                head_tensor(head, (p + ".feedforward_norm.weight").c_str()),
+                head_tensor(head, (p + ".feedforward_norm.bias").c_str()));
+        struct ggml_tensor * ff = (head_linear(ctx, head, (p + ".feedforward.0").c_str(), fn));
+        ff = head_gelu_erf(ctx, ff);
+        ff = (head_linear(ctx, head, (p + ".feedforward.3").c_str(), ff));
+        if (i == 0) {
+            ggml_set_name(fn, "head.ev0_fn");
+            ggml_set_name(ff, "head.ev0_ff");
+        }
+        routed = ggml_add(ctx, routed, ff);
+    }
+
+    ggml_set_name(routed, "head.routed_ev");
+
+    // Per-question option summaries (softmax over each question's options).
+    struct ggml_tensor * base_fields = head_mm(ctx, head, "question_projection.weight", qvec); // [e, nq]
+    ggml_set_name(base_fields, "head.base_fields");
+    struct ggml_tensor * scores = ggml_scale(
+            ctx, ggml_mul_mat(ctx, base_fields, routed), 1.0f / std::sqrt((float) e));          // [nq, no]
+    struct ggml_tensor * scores_t = ggml_cont(ctx, ggml_transpose(ctx, scores));                // [no, nq]
+    struct ggml_tensor * weights = ggml_soft_max(ctx, ggml_add(ctx, scores_t, mask));           // [no, nq]
+    struct ggml_tensor * summaries = ggml_mul_mat(ctx, ggml_cont(ctx, ggml_transpose(ctx, routed)), weights);                        // [e, nq]
+    ggml_set_name(summaries, "head.summaries");
+    summaries = head_layernorm(
+            ctx, summaries,
+            head_tensor(head, "option_summary_norm.weight"),
+            head_tensor(head, "option_summary_norm.bias"));
+
+    struct ggml_tensor * gp = head_mm(ctx, head, "global_projection.weight", glob);             // [e, 1]
+    struct ggml_tensor * te = ggml_get_rows(ctx, head_tensor(head, "type_embedding.weight"), type_ids); // [e, nq]
+    struct ggml_tensor * fields = ggml_add(ctx,
+            ggml_add(ctx, base_fields, summaries),
+            ggml_add(ctx, ggml_repeat(ctx, gp, base_fields), te));                              // [e, nq]
+
+    // Joint decoder over the questions.
+    for (int i = 0; i < head.layers; ++i) {
+        const std::string p = "layers." + std::to_string(i);
+        struct ggml_tensor * n1 = head_layernorm(
+                ctx, fields,
+                head_tensor(head, (p + ".norm1.weight").c_str()),
+                head_tensor(head, (p + ".norm1.bias").c_str()));
+        fields = ggml_add(ctx, fields, head_mha(ctx, head, (p + ".self_attn").c_str(), n1, n1, n1));
+        struct ggml_tensor * n2 = head_layernorm(
+                ctx, fields,
+                head_tensor(head, (p + ".norm2.weight").c_str()),
+                head_tensor(head, (p + ".norm2.bias").c_str()));
+        fields = ggml_add(ctx, fields, head_mha(ctx, head, (p + ".multihead_attn").c_str(), n2, memory, memory));
+        struct ggml_tensor * n3 = head_layernorm(
+                ctx, fields,
+                head_tensor(head, (p + ".norm3.weight").c_str()),
+                head_tensor(head, (p + ".norm3.bias").c_str()));
+        struct ggml_tensor * ff = (head_linear(ctx, head, (p + ".linear1").c_str(), n3));
+        ff = head_gelu_erf(ctx, ff);
+        ff = (head_linear(ctx, head, (p + ".linear2").c_str(), ff));
+        fields = ggml_add(ctx, fields, ff);
+    }
+    fields = head_layernorm(
+            ctx, fields,
+            head_tensor(head, "field_norm.weight"),
+            head_tensor(head, "field_norm.bias"));                                              // [e, nq]
+
+    ggml_set_name(fields, "head.fields");
+
+    // Scoring.
+    struct ggml_tensor * anchor = head_normalize(ctx, ggml_add(ctx, qvec, ggml_repeat(ctx, glob, qvec)));
+    ggml_set_name(anchor, "head.anchor");
+    struct ggml_tensor * lexn = head_normalize(ctx, lex);
+    struct ggml_tensor * prior = ggml_scale(ctx, ggml_mul_mat(ctx, lexn, anchor), head.prior_scale); // [no, nq]
+    ggml_set_name(prior, "head.prior");
+    struct ggml_tensor * oq_t = ggml_cont(ctx, ggml_transpose(ctx, oq));                            // [no, nq]
+    struct ggml_tensor * prior_o = ggml_sum_rows(
+            ctx, ggml_cont(ctx, ggml_transpose(ctx, ggml_mul(ctx, prior, oq_t))));                                  // [1, no]
+    ggml_set_name(prior_o, "head.prior_o");
+
+    struct ggml_tensor * opts_n = head_layernorm(
+            ctx, routed,
+            head_tensor(head, "option_norm.weight"),
+            head_tensor(head, "option_norm.bias"));                                                 // [e, no]
+    ggml_set_name(opts_n, "head.opts_n");
+    struct ggml_tensor * fexp = ggml_mul_mat(ctx, ggml_cont(ctx, ggml_transpose(ctx, fields)), oq);                                      // [e, no]
+    ggml_set_name(fexp, "head.fexp");
+
+    struct ggml_tensor * dot = ggml_sum_rows(ctx, ggml_mul(ctx, fexp, opts_n));
+    struct ggml_tensor * nf = ggml_sqrt(ctx, ggml_sum_rows(ctx, ggml_sqr(ctx, fexp)));
+    struct ggml_tensor * nn = ggml_sqrt(ctx, ggml_sum_rows(ctx, ggml_sqr(ctx, opts_n)));
+    struct ggml_tensor * denom = ggml_mul(
+            ctx,
+            ggml_clamp(ctx, nf, 1e-8f, std::numeric_limits<float>::max()),
+            ggml_clamp(ctx, nn, 1e-8f, std::numeric_limits<float>::max()));
+    struct ggml_tensor * cosine = ggml_div(ctx, dot, denom);                                        // [1, no]
+    ggml_set_name(cosine, "head.cosine");
+
+    struct ggml_tensor * features = ggml_concat(ctx,
+            ggml_concat(ctx,
+                ggml_concat(ctx, fexp, opts_n, 0),
+                ggml_mul(ctx, fexp, opts_n), 0),
+            ggml_abs(ctx, ggml_sub(ctx, fexp, opts_n)), 0);                                         // [4e, no]
+    struct ggml_tensor * residual = head_linear(ctx, head, "residual_scorer.0", features);
+    ggml_set_name(residual, "head.residual0");
+    residual = head_gelu_erf(ctx, residual);
+    residual = head_linear(ctx, head, "residual_scorer.3", residual);                               // [1, no]
+    ggml_set_name(residual, "head.residual");
+
+    struct ggml_tensor * joint = ggml_add(ctx, ggml_scale(ctx, cosine, head.joint_scale), residual);
+    return ggml_add(ctx, prior_o, ggml_scale(ctx, joint, head.gate));                               // [1, no]
+}
+
+bool head_layer_load(llama_head & head, const char * path, ggml_backend_t backend) {
+    struct gguf_init_params params;
+    params.no_alloc = true;
+    params.ctx = &head.ctx;
+
+    struct gguf_context * gguf = gguf_init_from_file(path, params);
+    if (!gguf || !head.ctx) {
+        fprintf(stderr, "llama_head: failed to open %s\n", path);
+        return false;
+    }
+
+    auto get_u32 = [&](const char * key, int fallback) -> int {
+        const int64_t id = gguf_find_key(gguf, key);
+        return id < 0 ? fallback : (int) gguf_get_val_u32(gguf, id);
+    };
+    head.hidden_size = get_u32("clef_head.hidden_size", 0);
+    head.width = get_u32("clef_head.width", 0);
+    head.routing_layers = get_u32("clef_head.routing_layers", 0);
+    head.layers = get_u32("clef_head.layers", 0);
+    head.n_heads = get_u32("clef_head.heads", 0);
+    head.feedforward = get_u32("clef_head.feedforward", 0);
+
+    const int64_t n_tensors = gguf_get_n_tensors(gguf);
+    for (int64_t i = 0; i < n_tensors; ++i) {
+        const char * name = gguf_get_tensor_name(gguf, i);
+        struct ggml_tensor * t = ggml_get_tensor(head.ctx, name);
+        if (!t) {
+            fprintf(stderr, "llama_head: tensor '%s' was not created\n", name);
+            gguf_free(gguf);
+            return false;
+        }
+        head.tensors[name] = t;
+    }
+
+    head.galloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
+    if (!head.galloc) {
+        fprintf(stderr, "llama_head: failed to create the graph allocator\n");
+        gguf_free(gguf);
+        return false;
+    }
+
+    head.buf = ggml_backend_alloc_ctx_tensors(head.ctx, backend);
+    if (!head.buf) {
+        fprintf(stderr, "llama_head: failed to allocate %lld tensors\n", (long long) n_tensors);
+        gguf_free(gguf);
+        return false;
+    }
+
+    FILE * file = fopen(path, "rb");
+    if (!file) {
+        gguf_free(gguf);
+        return false;
+    }
+    const size_t data_offset = gguf_get_data_offset(gguf);
+    std::vector<uint8_t> raw;
+    for (int64_t i = 0; i < n_tensors; ++i) {
+        const char * name = gguf_get_tensor_name(gguf, i);
+        struct ggml_tensor * t = head.tensors[name];
+        const size_t size = gguf_get_tensor_size(gguf, i);
+        raw.resize(size);
+        if (fseek(file, (long) (data_offset + gguf_get_tensor_offset(gguf, i)), SEEK_SET) != 0 ||
+            fread(raw.data(), 1, size, file) != size) {
+            fprintf(stderr, "llama_head: failed to read tensor '%s'\n", name);
+            fclose(file);
+            gguf_free(gguf);
+            return false;
+        }
+        ggml_backend_tensor_set(t, raw.data(), 0, size);
+    }
+    fclose(file);
+    gguf_free(gguf);
+
+    auto scalar = [&](const char * name, float fallback) -> float {
+        struct ggml_tensor * t = head_tensor(head, name);
+        if (!t) {
+            return fallback;
+        }
+        float value = fallback;
+        ggml_backend_tensor_get(t, &value, 0, sizeof(value));
+        return value;
+    };
+    const float log100 = std::log(100.0f);
+    head.prior_scale = std::exp(std::fmin(scalar("prior_logit_scale", 0.0f), log100));
+    head.joint_scale = std::exp(std::fmin(scalar("joint_logit_scale", 0.0f), log100));
+    head.gate = 1.0f / (1.0f + std::exp(-scalar("residual_gate", 0.0f)));
+
+    return head.hidden_size > 0 && head.width > 0 && head.n_heads > 0;
+}
+
+void head_layer_free(llama_head & head) {
+    if (head.req_buf) {
+        ggml_backend_buffer_free(head.req_buf);
+        head.req_buf = nullptr;
+    }
+    if (head.req_ctx) {
+        ggml_free(head.req_ctx);
+        head.req_ctx = nullptr;
+    }
+    if (head.galloc) {
+        ggml_gallocr_free(head.galloc);
+        head.galloc = nullptr;
+    }
+    if (head.buf) {
+        ggml_backend_buffer_free(head.buf);
+        head.buf = nullptr;
+    }
+    if (head.ctx) {
+        ggml_free(head.ctx);
+        head.ctx = nullptr;
+    }
+    head.tensors.clear();
+}
+
+bool head_prepare(
+        llama_head & head,
+        ggml_backend_t backend,
+        const llama_head_record & rec,
+        const float * acc_hidden,
+        int acc_rows) {
+    if (head.req_buf) {
+        ggml_backend_buffer_free(head.req_buf);
+        head.req_buf = nullptr;
+    }
+    if (head.req_ctx) {
+        ggml_free(head.req_ctx);
+        head.req_ctx = nullptr;
+    }
+    struct ggml_init_params params;
+    params.mem_size = ggml_tensor_overhead() * 64 + 65536;
+    params.mem_buffer = nullptr;
+    params.no_alloc = true;
+    head.req_ctx = ggml_init(params);
+    if (!head.req_ctx) {
+        return false;
+    }
+    head.t_a_q = ggml_new_tensor_2d(head.req_ctx, GGML_TYPE_F32, rec.n_tokens, rec.n_questions);
+    head.t_a_o = ggml_new_tensor_2d(head.req_ctx, GGML_TYPE_F32, rec.n_tokens, rec.n_options);
+    head.t_oq = ggml_new_tensor_2d(head.req_ctx, GGML_TYPE_F32, rec.n_questions, rec.n_options);
+    head.t_mask = ggml_new_tensor_2d(head.req_ctx, GGML_TYPE_F32, rec.n_options, rec.n_questions);
+    head.t_lex = ggml_new_tensor_2d(head.req_ctx, GGML_TYPE_F32, head.hidden_size, rec.n_options);
+    head.t_type = ggml_new_tensor_1d(head.req_ctx, GGML_TYPE_I32, rec.n_questions);
+    head.t_last = ggml_new_tensor_1d(head.req_ctx, GGML_TYPE_I32, 1);
+    head.t_acc = acc_rows > 0 ? ggml_new_tensor_2d(head.req_ctx, GGML_TYPE_F32, head.hidden_size, acc_rows) : nullptr;
+
+    head.req_buf = ggml_backend_alloc_ctx_tensors(head.req_ctx, backend);
+    if (!head.req_buf) {
+        return false;
+    }
+    ggml_backend_tensor_set(head.t_a_q, rec.a_q, 0, (size_t) rec.n_tokens * rec.n_questions * sizeof(float));
+    ggml_backend_tensor_set(head.t_a_o, rec.a_o, 0, (size_t) rec.n_tokens * rec.n_options * sizeof(float));
+    ggml_backend_tensor_set(head.t_oq, rec.oq, 0, (size_t) rec.n_questions * rec.n_options * sizeof(float));
+    ggml_backend_tensor_set(head.t_mask, rec.mask, 0, (size_t) rec.n_options * rec.n_questions * sizeof(float));
+    ggml_backend_tensor_set(head.t_lex, rec.lex, 0, (size_t) rec.n_options * head.hidden_size * sizeof(float));
+    ggml_backend_tensor_set(head.t_type, rec.type_ids, 0, (size_t) rec.n_questions * sizeof(int32_t));
+    int32_t last = rec.last_token;
+    ggml_backend_tensor_set(head.t_last, &last, 0, sizeof(int32_t));
+    if (head.t_acc) {
+        ggml_backend_tensor_set(head.t_acc, acc_hidden, 0, (size_t) acc_rows * head.hidden_size * sizeof(float));
+    }
+    head.rec_n_questions = rec.n_questions;
+    head.rec_n_options = rec.n_options;
+    head.rec_n_tokens = rec.n_tokens;
+    return true;
+}
+
+struct ggml_tensor * head_build_graph(
+        struct ggml_context * ctx,
+        const llama_head & head,
+        struct ggml_tensor * hidden) {
+    if (!ctx || !hidden || head.rec_n_questions <= 0 || head.rec_n_options <= 0) {
+        return nullptr;
+    }
+    llama_head_record rec;
+    rec.n_tokens = (int) hidden->ne[1];
+    rec.n_questions = head.rec_n_questions;
+    rec.n_options = head.rec_n_options;
+    return build_head(ctx, head, rec, hidden, head.t_a_q, head.t_a_o, head.t_oq, head.t_mask, head.t_lex, head.t_type, head.t_last);
+}
+
+bool head_layer_forward(
+        const llama_head & head,
+        ggml_backend_t backend,
+        const llama_head_record & rec,
+        const float * hidden,
+        std::vector<float> & logits) {
+    if (!backend || rec.n_tokens <= 0 || rec.n_questions <= 0 || rec.n_options <= 0) {
+        LLAMA_LOG_ERROR("%s: bad record tokens=%d questions=%d options=%d backend=%p\n",
+                __func__, rec.n_tokens, rec.n_questions, rec.n_options, (void *) backend);
+        return false;
+    }
+    LLAMA_LOG_DEBUG("%s: tokens=%d questions=%d options=%d\n", __func__, rec.n_tokens, rec.n_questions, rec.n_options);
+    const size_t mem_size = ggml_tensor_overhead() * 2048 + ggml_graph_overhead() * 4 + (1 << 20);
+    struct ggml_init_params params;
+    params.mem_size = mem_size;
+    params.mem_buffer = nullptr;
+    params.no_alloc = true;
+    struct ggml_context * ctx = ggml_init(params);
+    if (!ctx) {
+        return false;
+    }
+
+    const int T = rec.n_tokens;
+    const int nq = rec.n_questions;
+    const int no = rec.n_options;
+
+    struct ggml_tensor * t_hidden = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head.hidden_size, T);
+    struct ggml_tensor * t_a_q = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, T, nq);
+    struct ggml_tensor * t_a_o = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, T, no);
+    struct ggml_tensor * t_oq = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, nq, no);
+    struct ggml_tensor * t_mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, no, nq);
+    struct ggml_tensor * t_lex = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head.hidden_size, no);
+    struct ggml_tensor * t_type = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, nq);
+    struct ggml_tensor * t_last = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+    ggml_set_input(t_hidden);
+    ggml_set_input(t_a_q);
+    ggml_set_input(t_a_o);
+    ggml_set_input(t_oq);
+    ggml_set_input(t_mask);
+    ggml_set_input(t_lex);
+    ggml_set_input(t_type);
+    ggml_set_input(t_last);
+
+    struct ggml_tensor * out = build_head(
+            ctx, head, rec, t_hidden, t_a_q, t_a_o, t_oq, t_mask, t_lex, t_type, t_last);
+    if (!out) {
+        LLAMA_LOG_ERROR("%s: head graph build failed\n", __func__);
+        ggml_free(ctx);
+        return false;
+    }
+
+    struct ggml_cgraph * graph = ggml_new_graph_custom(ctx, 8192, false);
+    ggml_build_forward_expand(graph, out);
+    if (!ggml_gallocr_alloc_graph(head.galloc, graph)) {
+        LLAMA_LOG_ERROR("%s: graph tensor allocation failed\n", __func__);
+        ggml_free(ctx);
+        return false;
+    }
+
+    ggml_backend_tensor_set(t_hidden, hidden, 0, (size_t) T * head.hidden_size * sizeof(float));
+    ggml_backend_tensor_set(t_a_q, rec.a_q, 0, (size_t) T * nq * sizeof(float));
+    ggml_backend_tensor_set(t_a_o, rec.a_o, 0, (size_t) T * no * sizeof(float));
+    ggml_backend_tensor_set(t_oq, rec.oq, 0, (size_t) nq * no * sizeof(float));
+    ggml_backend_tensor_set(t_mask, rec.mask, 0, (size_t) no * nq * sizeof(float));
+    ggml_backend_tensor_set(t_lex, rec.lex, 0, (size_t) no * head.hidden_size * sizeof(float));
+    ggml_backend_tensor_set(t_type, rec.type_ids, 0, (size_t) nq * sizeof(int32_t));
+    ggml_backend_tensor_set(t_last, &rec.last_token, 0, sizeof(int32_t));
+
+    const enum ggml_status status = ggml_backend_graph_compute(backend, graph);
+    if (status != GGML_STATUS_SUCCESS) {
+        LLAMA_LOG_ERROR("%s: graph compute failed (%d)\n", __func__, (int) status);
+        ggml_free(ctx);
+        return false;
+    }
+
+    logits.resize(no);
+    ggml_backend_tensor_get(out, logits.data(), 0, (size_t) no * sizeof(float));
+
+    const char * debug_dir = getenv("LLAMA_HEAD_DEBUG");
+    if (debug_dir) {
+        auto dump_input = [&](struct ggml_tensor * t, const char * name) {
+            std::vector<float> data((size_t) ggml_nelements(t));
+            ggml_backend_tensor_get(t, data.data(), 0, data.size() * sizeof(float));
+            char path[512];
+            snprintf(path, sizeof(path), "%s/%s.f32", debug_dir, name);
+            FILE * f = fopen(path, "wb");
+            if (f) { fwrite(data.data(), sizeof(float), data.size(), f); fclose(f); }
+        };
+        dump_input(t_hidden, "head.in_hidden");
+        dump_input(t_a_q, "head.in_a_q");
+        dump_input(t_a_o, "head.in_a_o");
+        dump_input(t_lex, "head.in_lex");
+        dump_input(head_tensor(head, "option_lexical_projection.weight"), "head.w_lex");
+        dump_input(head_tensor(head, "option_context_projection.weight"), "head.w_ctx");
+        const int n_nodes = ggml_graph_n_nodes(graph);
+        for (int i = 0; i < n_nodes; ++i) {
+            struct ggml_tensor * node = ggml_graph_node(graph, i);
+            if (!node->name[0] || strncmp(node->name, "head.", 5) != 0) {
+                continue;
+            }
+            std::vector<float> data((size_t) ggml_nelements(node));
+            ggml_backend_tensor_get(node, data.data(), 0, data.size() * sizeof(float));
+            char path[512];
+            snprintf(path, sizeof(path), "%s/%s.f32", debug_dir, node->name);
+            FILE * f = fopen(path, "wb");
+            if (f) {
+                fwrite(data.data(), sizeof(float), data.size(), f);
+                fclose(f);
+                fprintf(stderr, "head debug: %s dims %lld x %lld\n", node->name, (long long) node->ne[0], (long long) node->ne[1]);
+            }
+        }
+    }
+    ggml_free(ctx);
+    return true;
+}
